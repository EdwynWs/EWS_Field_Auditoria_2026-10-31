# Copy to backend/.env. Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:LOCAL_PASSWORD@127.0.0.1:5432/ews_field
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
ALLOW_PUBLIC_SIGNUP=false
MEDIA_DIR=./private-media
DB_POOL_MAX=10
# Set only to the actual trusted reverse proxy addresses in production.
TRUST_PROXY=
