{
  "name": "ews-field",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "backend",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "db:init": "npm run db:init -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "test": "npm run test -w backend",
    "build:web": "npm run build -w web",
    "check": "node scripts/check.mjs",
    "postinstall": "node scripts/patch-metro.mjs",
    "test:e2e": "playwright test",
    "test:wasm": "TEST_PGLITE=true npm test"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "overrides": {
    "postcss": "8.5.32",
    "image-size": "2.0.4",
    "sharp": "0.35.5",
    "expo-font": "14.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
