{
  "expo": {
    "name": "EWS Field",
    "slug": "ews-field",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.ewstech.ewsfield",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1,
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.ewstech.ewsfield",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização apenas quando você registra chegada ou saída de um atendimento.",
        "NSCameraUsageDescription": "Usamos a câmera para comprovar atendimentos."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O GPS é usado apenas ao registrar visitas."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir fotos de atendimentos?",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "535fa246-8385-4295-a7fd-4fc85549250f"
      }
    },
    "owner": "edwyn007",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    }
  }
}
